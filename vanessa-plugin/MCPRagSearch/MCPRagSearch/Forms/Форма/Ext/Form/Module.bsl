// ============================================================================
// MCPRagSearch — плагин Vanessa Automation: MCP сервер + семантический поиск.
//
// Транспорт — внешняя компонента http1c (libhttp1cWin.dll, AddIn.VAHttp1c.HttpServer):
//   - инструменты MCP собираются из MCPVA (ВызватьРегистрациюИнструментовMCP)
//     через фасад этой формы и передаются в компоненту (ПрименитьНастройки);
//   - вызовы инструментов приходят событием ВнешнееСобытие/ToolCall и
//     диспетчеризуются обратно в обработчики MCPVA;
//   - ответ — конверт {"id":..., "body":"<json>"}: body — СТРОКА с уже
//     сериализованным результатом MCP (двойная сериализация, протокол http1c);
//   - промпт search-guide (prompts_json) — инструкция для ИИ-агента из макета
//     СкилПоиска, отдаётся по событию PromptGet тем же конвертом {id, body};
//     дубль — инструмент get_search_guide (для клиентов, прячущих промпты).
//
// RAG — Rust-ядро rcore.dll за методом компоненты RagВыполнить(метод, json):
//   configure → delete_collection → index_segments (батчи) → база знаний
//   (коллекция "vanessa_kb") → коллекции файлов из таблицы формы (на каждую:
//   delete_collection → index_raw по одному файлу) → опрос stats до
//   vector_status = "ready" по всем коллекциям.
//   Коллекция "vanessa_steps" — все шаги VA.
// ============================================================================

#Область ОписаниеПеременных

&НаКлиенте
Перем Ванесса;

&НаКлиенте
Перем МодульMCPVA;

&НаКлиенте
Перем Компонента;

&НаКлиенте
Перем ТранспортЗапущен;

&НаКлиенте
Перем ОжидающиеЗапросы; // Соответствие: идентификатор запроса -> Истина

&НаКлиенте
Перем РежимДиспетчеризации;

&НаКлиенте
Перем РежимСбораИнструментов;

&НаКлиенте
Перем СписокИнструментовСбор; // Массив структур {name, description, inputSchema}

&НаКлиенте
Перем КартаОбработчиков; // Соответствие: имя инструмента -> имя процедуры МодульMCPVA

&НаКлиенте
Перем ОчередьИндексации; // Массив подготовленных пакетов index_segments

&НаКлиенте
Перем ОчередьКоллекцийФайлов; // Массив структур {Имя, Описание, Каталог, Расширения} из таблицы формы

&НаКлиенте
Перем ТекущаяКоллекцияФайлов; // Структура обрабатываемой коллекции: + Файлы (массив путей), Индекс, ТекущийФайл

&НаКлиенте
Перем RagНастроен;

&НаКлиенте
Перем СсылкаНаМодельURL; // страница выбранной модели на Hugging Face (для декорации СсылкаНаМодель)

&НаКлиенте
Перем ЯзыкИндексации; // язык генератора Gherkin на момент индексации шагов (meta.lang)

&НаКлиенте
Перем КоличествоШаговПриИндексации; // размер библиотеки шагов на момент индексации

#КонецОбласти

#Область ИнтерфейсПлагина

&НаКлиенте
Процедура УстановитьСлужебныеПеременные(КонтекстФреймворка) Экспорт
	Ванесса = КонтекстФреймворка;
КонецПроцедуры

&НаКлиенте
Процедура Инициализация(КонтекстЯдраПараметр) Экспорт
	Ванесса = КонтекстЯдраПараметр;
КонецПроцедуры

// Делает отключение модуля
&НаКлиенте
Функция ОтключениеМодуля() Экспорт

	ОстановитьТранспорт();
	Ванесса = Неопределено;

КонецФункции

&НаКлиенте
Функция ОписаниеПлагина(ВозможныеТипыПлагинов) Экспорт
	Возврат ОписаниеПлагинаНаСервере(ВозможныеТипыПлагинов);
КонецФункции

&НаСервере
Функция ОписаниеПлагинаНаСервере(ВозможныеТипыПлагинов)
	Возврат РеквизитФормыВЗначение("Объект").ОписаниеПлагина(ВозможныеТипыПлагинов);
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
#Если НЕ ВебКлиент Тогда
	ИнициализироватьСостояние();

	Если Порт = 0 Тогда
		Порт = 8765;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(РежимРаботы) Тогда
		РежимРаботы = "MCP";
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Модель) Тогда
		Модель = "multilingual-e5-small";
		// первый запуск (настройки ещё не сохранялись): 1 поток индексации —
		// каждая сессия модели стоит ~0.5–1.5 ГБ RAM; 0 (= авто, половина
		// ядер, максимум 4) пользователь включает осознанно
		ПотокиИндексации = 1;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Устройство) Тогда
		Устройство = "auto";
	КонецЕсли;

	Элементы.Модель.КнопкаВыпадающегоСписка = Истина;
	ЗаполнитьСписокВыбораМоделей(СписокМоделейПоУмолчанию());

	Элементы.Устройство.РежимВыбораИзСписка = Истина;
	Элементы.Устройство.СписокВыбора.Очистить();
	Элементы.Устройство.СписокВыбора.Добавить("auto");
	Элементы.Устройство.СписокВыбора.Добавить("dml");
	Элементы.Устройство.СписокВыбора.Добавить("cpu");

	СтатусСервера = НСтр("ru = 'Остановлен'; en = 'Stopped'");
	СтатусИндексации = "";
	СчетчикИнструментов = 0;

	ОбновитьСсылкуНаМодель();
	ОбновитьДоступностьЭлементов();
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
#Если НЕ ВебКлиент Тогда
	// Без вопросов: просто останавливаем транспорт.
	Попытка
		ОстановитьТранспорт();
	Исключение
	КонецПопытки;
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
#Если НЕ ВебКлиент Тогда
	Если Источник <> "HttpServer" Тогда
		Возврат;
	КонецЕсли;
	Если Компонента = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ИнициализироватьСостояние();

	Если Событие = "ToolCall" Тогда
		ОбработатьВызовИнструмента(Данные);
	ИначеЕсли Событие = "PromptGet" Тогда
		ОбработатьЗапросПромпта(Данные);
	ИначеЕсли Событие = "ResourceRead" Тогда
		Сообщение = ПрочитатьJSONИзСтроки(Данные);
		Если ТипЗнч(Сообщение) = Тип("Соответствие") Тогда
			Идентификатор = Сообщение["id"];
			ОжидающиеЗапросы.Вставить(Идентификатор, Истина);
			ОтправитьРезультатИнструмента(Идентификатор, Событие + " is not supported", Истина);
		КонецЕсли;
	КонецЕсли;
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура РежимРаботыПриИзменении(Элемент)
	ОбновитьДоступностьЭлементов();
	Если РежимРаботы = "MCP+RAG" И ТранспортЗапущен = Истина И RagНастроен <> Истина Тогда
		СтатусИндексации = НСтр("ru = 'Нажмите «Переиндексировать» для запуска семантического поиска';
			|en = 'Press ""Reindex"" to start semantic search'");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура МодельПриИзменении(Элемент)
	ОбновитьСсылкуНаМодель();
КонецПроцедуры

&НаКлиенте
Процедура СсылкаНаМодельНажатие(Элемент, СтандартнаяОбработка)
#Если НЕ ВебКлиент Тогда
	СтандартнаяОбработка = Ложь;
	Если НЕ ЗначениеЗаполнено(СсылкаНаМодельURL) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		НачатьЗапускПриложения(
			Новый ОписаниеОповещения("ЗапускБраузераЗавершение", ЭтотОбъект), СсылкаНаМодельURL);
	Исключение
		// не удалось открыть браузер — молча игнорируем
	КонецПопытки;
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ЗапускБраузераЗавершение(КодВозврата, ДополнительныеПараметры) Экспорт
	// fire-and-forget: код возврата браузера не важен
КонецПроцедуры

&НаКлиенте
Процедура КаталогКомпонентыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
#Если НЕ ВебКлиент Тогда
	СтандартнаяОбработка = Ложь;
	НачатьВыборКаталога("КаталогКомпонентыВыборЗавершение", КаталогКомпоненты,
		НСтр("ru = 'Каталог компоненты (libhttp1cWin.dll, rcore.dll, DirectML.dll)';
			|en = 'Add-in directory (libhttp1cWin.dll, rcore.dll, DirectML.dll)'"));
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура КаталогКомпонентыВыборЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
#Если НЕ ВебКлиент Тогда
	Если ТипЗнч(ВыбранныеФайлы) = Тип("Массив") И ВыбранныеФайлы.Количество() > 0 Тогда
		КаталогКомпоненты = ВыбранныеФайлы[0];
	КонецЕсли;
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура СсылкаСкачатьКомпонентуНажатие(Элемент, СтандартнаяОбработка)
#Если НЕ ВебКлиент Тогда
	СтандартнаяОбработка = Ложь;
	Попытка
		НачатьЗапускПриложения(
			Новый ОписаниеОповещения("ЗапускБраузераЗавершение", ЭтотОбъект),
			"https://github.com/DitriXNew/MCP-DB-Client/releases/latest/download/http1c-addin-full.zip");
	Исключение
		// не удалось открыть браузер — молча игнорируем
	КонецПопытки;
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура КаталогМоделейНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
#Если НЕ ВебКлиент Тогда
	СтандартнаяОбработка = Ложь;
	НачатьВыборКаталога("КаталогМоделейВыборЗавершение", КаталогМоделей,
		НСтр("ru = 'Каталог загрузки/кэша моделей'; en = 'Models download/cache directory'"));
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура КаталогМоделейВыборЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
#Если НЕ ВебКлиент Тогда
	Если ТипЗнч(ВыбранныеФайлы) = Тип("Массив") И ВыбранныеФайлы.Количество() > 0 Тогда
		КаталогМоделей = ВыбранныеФайлы[0];
	КонецЕсли;
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ФайлЛогаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
#Если НЕ ВебКлиент Тогда
	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = НСтр("ru = 'Файл лога компоненты'; en = 'Add-in log file'");
	Диалог.Фильтр = НСтр("ru = 'Лог (*.log;*.txt)|*.log;*.txt|Все файлы|*.*';
		|en = 'Log (*.log;*.txt)|*.log;*.txt|All files|*.*'");
	Если ЗначениеЗаполнено(ФайлЛога) Тогда
		Диалог.ПолноеИмяФайла = ФайлЛога;
	КонецЕсли;
	Диалог.Показать(Новый ОписаниеОповещения("ФайлЛогаВыборЗавершение", ЭтотОбъект));
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ФайлЛогаВыборЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
#Если НЕ ВебКлиент Тогда
	Если ТипЗнч(ВыбранныеФайлы) = Тип("Массив") И ВыбранныеФайлы.Количество() > 0 Тогда
		ФайлЛога = ВыбранныеФайлы[0];
	КонецЕсли;
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаКоллекцийКаталогНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
#Если НЕ ВебКлиент Тогда
	СтандартнаяОбработка = Ложь;
	ДанныеСтроки = Элементы.ТаблицаКоллекций.ТекущиеДанные;
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	// строка таблицы уходит в колбэк через ДополнительныеПараметры
	ПараметрыВыбора = Новый Структура("ДанныеСтроки", ДанныеСтроки);
	НачатьВыборКаталога("ТаблицаКоллекцийКаталогВыборЗавершение", ДанныеСтроки.Каталог,
		НСтр("ru = 'Каталог файлов коллекции'; en = 'Collection files directory'"), ПараметрыВыбора);
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаКоллекцийКаталогВыборЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
#Если НЕ ВебКлиент Тогда
	Если ТипЗнч(ВыбранныеФайлы) = Тип("Массив") И ВыбранныеФайлы.Количество() > 0 Тогда
		ДополнительныеПараметры.ДанныеСтроки.Каталог = ВыбранныеФайлы[0];
	КонецЕсли;
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура НачатьВыборКаталога(ИмяОбработчика, ТекущийКаталог, Заголовок, ДополнительныеПараметры = Неопределено)
#Если НЕ ВебКлиент Тогда
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Заголовок = Заголовок;
	Если ЗначениеЗаполнено(ТекущийКаталог) Тогда
		Диалог.Каталог = ТекущийКаталог;
	КонецЕсли;
	Диалог.Показать(Новый ОписаниеОповещения(ИмяОбработчика, ЭтотОбъект, ДополнительныеПараметры));
#КонецЕсли
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Запустить(Команда)
#Если НЕ ВебКлиент Тогда
	НачатьЗапускТранспорта();
#КонецЕсли
КонецПроцедуры

// Программный запуск (сервисная фича, e2e, автоматизация). Настройки - Структура
// с любыми из полей: Порт, КаталогКомпоненты, РежимРаботы, Модель, КаталогМоделей,
// Устройство, ТокенАвторизации, ВестиЛог, ФайлЛога.
&НаКлиенте
Процедура ЗапуститьСНастройками(Настройки) Экспорт
#Если НЕ ВебКлиент Тогда
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из Настройки Цикл
			Попытка
				ЭтотОбъект[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
			Исключение
				// нет такого реквизита — пропускаем
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;
	ОбновитьСсылкуНаМодель();
	ОбновитьДоступностьЭлементов();
	НачатьЗапускТранспорта();
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура НачатьЗапускТранспорта()
#Если НЕ ВебКлиент Тогда
	ИнициализироватьСостояние();

	Если ТранспортЗапущен = Истина Тогда
		Сообщить(СтрШаблон(НСтр("ru = 'MCP сервер уже запущен на порту %1.'; en = 'MCP server is already running on port %1.'"),
			Формат(Порт, "ЧГ=0")));
		Возврат;
	КонецЕсли;

	СистемнаяИнформация = Новый СистемнаяИнформация;
	Если СистемнаяИнформация.ТипПлатформы <> ТипПлатформы.Windows_x86_64 Тогда
		Сообщить(НСтр("ru = 'Компонента http1c доступна только для Windows x86-64.';
			|en = 'The http1c add-in is only available on Windows x86-64.'"));
		Возврат;
	КонецЕсли;

	Если Ванесса = Неопределено Тогда
		НайтиКонтекстВанессы();
	КонецЕсли;
	Если Ванесса = Неопределено Тогда
		Сообщить(НСтр("ru = 'Откройте Vanessa Automation.'; en = 'Open Vanessa Automation.'"));
		Возврат;
	КонецЕсли;

	МодульMCPVA = Ванесса.МодульMCPVA();

	// Источник компоненты: по умолчанию — встроенный полный бандл из макета
	// «КомпонентаHttp1c» (1С сама распакует zip со всеми dll), путь указывать не
	// нужно. «Каталог компоненты» — необязательное переопределение: если заполнен,
	// грузим libhttp1cWin.dll из указанной папки (свой/dev-бандл).
	Если ЗначениеЗаполнено(КаталогКомпоненты) Тогда
		ИсточникКомпоненты = КаталогКомпоненты;
		Если Прав(ИсточникКомпоненты, 1) <> "\" И Прав(ИсточникКомпоненты, 1) <> "/" Тогда
			ИсточникКомпоненты = ИсточникКомпоненты + "\";
		КонецЕсли;
		ИсточникКомпоненты = ИсточникКомпоненты + "libhttp1cWin.dll";
		ОписаниеИсточника = КаталогКомпоненты;
	Иначе
		Попытка
			ИсточникКомпоненты = АдресВстроеннойКомпоненты();
		Исключение
			СтатусСервера = НСтр("ru = 'Ошибка: встроенная компонента недоступна'; en = 'Error: embedded add-in unavailable'");
			Сообщить(СтрШаблон(НСтр("ru = 'Не удалось получить встроенную компоненту из макета: %1. Укажите «Каталог компоненты» с распакованным бандлом.';
				|en = 'Failed to read the embedded add-in from the template: %1. Set the ""Add-in directory"" to an unpacked bundle.'"), ОписаниеОшибки()));
			Возврат;
		КонецПопытки;
		ОписаниеИсточника = НСтр("ru = 'встроенный макет'; en = 'embedded template'");
	КонецЕсли;

	СтатусСервера = НСтр("ru = 'Подключение компоненты...'; en = 'Attaching the add-in...'");
	Оповещение = Новый ОписаниеОповещения("ПодключениеКомпонентыЗавершение", ЭтотОбъект, ОписаниеИсточника);
	// НеИзолированно поддерживается не всеми версиями платформы — вызываем через
	// Выполнить с откатом на 4-арговый вариант (паттерн VA, УправляемаяФорма).
	Попытка
		Выполнить("НачатьПодключениеВнешнейКомпоненты(Оповещение, ИсточникКомпоненты, ""VAHttp1c"", ТипВнешнейКомпоненты.Native, ТипПодключенияВнешнейКомпоненты.НеИзолированно)");
	Исключение
		НачатьПодключениеВнешнейКомпоненты(Оповещение, ИсточникКомпоненты, "VAHttp1c", ТипВнешнейКомпоненты.Native);
	КонецПопытки;
#КонецЕсли
КонецПроцедуры

// Встроенный полный бандл компоненты (макет «КомпонентаHttp1c», тип «Внешняя
// компонента») кладётся во временное хранилище; адрес передаётся прямо в
// НачатьПодключениеВнешнейКомпоненты — платформа сама распакует zip со всеми dll
// (libhttp1cWin.dll, rcore.dll, DirectML.dll). Путь к файлам указывать не нужно.
&НаСервере
Функция АдресВстроеннойКомпоненты()
	Объект = РеквизитФормыВЗначение("Объект");
	ДвоичныеДанные = Объект.ПолучитьМакет("КомпонентаHttp1c");
	Возврат ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
КонецФункции

&НаКлиенте
Процедура Остановить(Команда)
#Если НЕ ВебКлиент Тогда
	Если ТранспортЗапущен <> Истина Тогда
		Сообщить(НСтр("ru = 'MCP сервер не запущен.'; en = 'MCP server is not running.'"));
		Возврат;
	КонецЕсли;
	ОстановитьТранспорт();
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура Переиндексировать(Команда)
#Если НЕ ВебКлиент Тогда
	Если ТранспортЗапущен <> Истина Тогда
		Сообщить(НСтр("ru = 'Сначала запустите MCP сервер.'; en = 'Start the MCP server first.'"));
		Возврат;
	КонецЕсли;
	Если РежимРаботы <> "MCP+RAG" Тогда
		Сообщить(НСтр("ru = 'Переиндексация доступна только в режиме MCP+RAG.'; en = 'Reindexing is only available in MCP+RAG mode.'"));
		Возврат;
	КонецЕсли;

	// Всегда через reset + configure (НачатьКонфигурациюRag): иначе коллекции,
	// переименованные или удалённые из таблицы, навсегда остаются в ядре и
	// раздувают счётчик сегментов от переиндексации к переиндексации.
	НачатьКонфигурациюRag();
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатус(Команда)
#Если НЕ ВебКлиент Тогда
	Если Компонента = Неопределено Тогда
		СтатусСервера = НСтр("ru = 'Остановлен'; en = 'Stopped'");
		Возврат;
	КонецЕсли;
	Попытка
		Компонента.НачатьВызовПолучитьСтатус(
			Новый ОписаниеОповещения("ПолучениеСтатусаЗавершение", ЭтотОбъект));
	Исключение
		СтатусСервера = СтрШаблон(НСтр("ru = 'Ошибка опроса статуса: %1'; en = 'Status polling error: %1'"),
			ОписаниеОшибки());
	КонецПопытки;
	Если РежимРаботы = "MCP+RAG" И ТранспортЗапущен = Истина Тогда
		РагВызов("stats", "{}", "ОпросСтатусаИндексацииЗавершение");
	КонецЕсли;
#КонецЕсли
КонецПроцедуры

// Установка компоненты из распакованного бандла: пользователь скачал и
// распаковал http1c-addin-full.zip сам, путь указывает в поле
// «Каталог компоненты» — кнопка проверяет состав указанного каталога.
&НаКлиенте
Процедура УстановитьИзПапки(Команда)
#Если НЕ ВебКлиент Тогда
	Если НЕ ЗначениеЗаполнено(КаталогКомпоненты) Тогда
		Сообщить(НСтр("ru = 'Заполните поле «Каталог компоненты» — укажите каталог с распакованным бандлом (libhttp1cWin.dll).';
			|en = 'Fill in the ""Add-in directory"" field — point it to the directory with the unpacked bundle (libhttp1cWin.dll).'"));
		Возврат;
	КонецЕсли;
	ПроверитьИПринятьКаталогКомпоненты(КаталогКомпоненты);
#КонецЕсли
КонецПроцедуры

// Завершение установки: проверяет состав каталога и, если компонента на
// месте, делает его текущим КаталогКомпоненты.
&НаКлиенте
Процедура ПроверитьИПринятьКаталогКомпоненты(Каталог)
#Если НЕ ВебКлиент Тогда
	КаталогСРазделителем = Каталог;
	Если Прав(КаталогСРазделителем, 1) <> "\" И Прав(КаталогСРазделителем, 1) <> "/" Тогда
		КаталогСРазделителем = КаталогСРазделителем + "\";
	КонецЕсли;

	ФайлКомпоненты = Новый Файл(КаталогСРазделителем + "libhttp1cWin.dll");
	Если НЕ ФайлКомпоненты.Существует() Тогда
		Сообщить(НСтр("ru = 'В каталоге нет libhttp1cWin.dll — это не бандл компоненты http1c.';
			|en = 'The directory does not contain libhttp1cWin.dll — this is not an http1c add-in bundle.'"));
		Возврат;
	КонецЕсли;

	ФайлЯдра = Новый Файл(КаталогСРазделителем + "rcore.dll");
	Если НЕ ФайлЯдра.Существует() Тогда
		Сообщить(НСтр("ru = 'В бандле нет rcore.dll — это lite-бандл, семантический поиск (режим MCP+RAG) будет недоступен.';
			|en = 'The bundle does not contain rcore.dll — this is a lite bundle, semantic search (MCP+RAG mode) will be unavailable.'"));
	КонецЕсли;

	КаталогКомпоненты = Каталог;
	Сообщить(СтрШаблон(НСтр("ru = 'Компонента установлена в %1. Нажмите ""Запустить"".';
		|en = 'Add-in installed to %1. Press ""Start"".'"), Каталог));
#КонецЕсли
КонецПроцедуры

#КонецОбласти

#Область ЗапускТранспорта

&НаКлиенте
Процедура ПодключениеКомпонентыЗавершение(Подключение, ДополнительныеПараметры) Экспорт
#Если НЕ ВебКлиент Тогда
	ОписаниеИсточника = ?(ДополнительныеПараметры = Неопределено, КаталогКомпоненты, ДополнительныеПараметры);
	Если НЕ Подключение Тогда
		СтатусСервера = НСтр("ru = 'Ошибка: не удалось подключить libhttp1cWin.dll';
			|en = 'Error: failed to attach libhttp1cWin.dll'");
		Сообщить(СтрШаблон(НСтр("ru = 'Не удалось подключить внешнюю компоненту (%1)';
			|en = 'Failed to attach the external add-in (%1)'"), ОписаниеИсточника));
		Возврат;
	КонецЕсли;

	Попытка
		Компонента = Новый("AddIn.VAHttp1c.HttpServer");
	Исключение
		СтатусСервера = НСтр("ru = 'Ошибка создания объекта компоненты'; en = 'Error creating the add-in object'");
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	// Версию компоненты проверяем ДО применения настроек: если через «Каталог
	// компоненты» подсунули старый бандл, плагин может слать ему незнакомые поля —
	// лучше громко отказать, чем тихо деградировать (см. ПроверкаВерсииКомпонентыЗавершение).
	СтатусСервера = НСтр("ru = 'Проверка версии компоненты...'; en = 'Checking the add-in version...'");
	Попытка
		Компонента.НачатьВызовПолучитьСтатус(
			Новый ОписаниеОповещения("ПроверкаВерсииКомпонентыЗавершение", ЭтотОбъект));
	Исключение
		// статус недоступен — продолжаем без гуарда (версию показать не сможем)
		ПродолжитьЗапускПослеПроверкиВерсии();
	КонецПопытки;
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаВерсииКомпонентыЗавершение(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт
#Если НЕ ВебКлиент Тогда
	Версия = "";
	Попытка
		Статус = ПрочитатьJSONИзСтроки(РезультатВызова);
		Если ТипЗнч(Статус) = Тип("Соответствие") Тогда
			Версия = СокрЛП(Строка(Статус["version"]));
		КонецЕсли;
	Исключение
	КонецПопытки;
	ВерсияКомпоненты = ?(ЗначениеЗаполнено(Версия), Версия, НСтр("ru = 'неизвестно'; en = 'unknown'"));

	Минимум = МинимальнаяВерсияКомпоненты();
	Если ЗначениеЗаполнено(Версия) И СравнитьВерсии(Версия, Минимум) < 0 Тогда
		Компонента = Неопределено;
		ТранспортЗапущен = Ложь;
		СтатусСервера = СтрШаблон(НСтр("ru = 'Несовместимая версия компоненты: %1 (нужна %2+)';
			|en = 'Incompatible add-in version: %1 (need %2+)'"), Версия, Минимум);
		Сообщить(СтрШаблон(НСтр("ru = 'Версия компоненты %1 старее требуемой %2. Обновите бандл, либо очистите поле «Каталог компоненты», чтобы использовать встроенный полный бандл.';
			|en = 'Add-in version %1 is older than the required %2. Update the bundle, or clear the ""Add-in directory"" field to use the embedded full bundle.'"), Версия, Минимум));
		ОбновитьДоступностьЭлементов();
		Возврат;
	КонецЕсли;

	ПродолжитьЗапускПослеПроверкиВерсии();
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗапускПослеПроверкиВерсии()
#Если НЕ ВебКлиент Тогда
	Попытка
		СобратьИнструментыMCP();
	Исключение
		СтатусСервера = НСтр("ru = 'Ошибка сбора инструментов MCP'; en = 'Error collecting MCP tools'");
		Сообщить(ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Конфигурация = Новый Структура;
	Конфигурация.Вставить("tools_json", ЗаписатьJSONВСтроку(СписокИнструментовСбор));
	Конфигурация.Вставить("prompts_json", ПромптыJson());
	Конфигурация.Вставить("timeout", 600);
	Конфигурация.Вставить("logging_enabled", ВестиЛог = Истина);
	Если ЗначениеЗаполнено(ФайлЛога) Тогда
		Конфигурация.Вставить("log_path", ФайлЛога);
	КонецЕсли;
	Если ЗначениеЗаполнено(ТокенАвторизации) Тогда
		Конфигурация.Вставить("auth_token", ТокенАвторизации);
	КонецЕсли;

	СтатусСервера = НСтр("ru = 'Применение настроек...'; en = 'Applying settings...'");
	Попытка
		Компонента.НачатьВызовПрименитьНастройки(
			Новый ОписаниеОповещения("ПрименениеНастроекЗавершение", ЭтотОбъект),
			ЗаписатьJSONВСтроку(Конфигурация));
	Исключение
		СтатусСервера = НСтр("ru = 'Ошибка применения настроек'; en = 'Error applying settings'");
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Функция МинимальнаяВерсияКомпоненты()
	// Минимальная версия libhttp1cWin.dll, с которой совместим этот плагин.
	// Встроенный макет всегда её удовлетворяет; гуард ловит старый бандл,
	// подсунутый через «Каталог компоненты».
	Возврат "2.3.0";
КонецФункции

&НаКлиенте
Функция СравнитьВерсии(А, Б)
	// -1 / 0 / 1 по покомпонентному числовому сравнению "X.Y.Z" (нечисловые → 0).
	ЧастиА = СтрРазделить(СтрЗаменить(СтрЗаменить(А, "-", "."), "+", "."), ".", Истина);
	ЧастиБ = СтрРазделить(СтрЗаменить(СтрЗаменить(Б, "-", "."), "+", "."), ".", Истина);
	Всего = ЧастиА.Количество();
	Если ЧастиБ.Количество() > Всего Тогда
		Всего = ЧастиБ.Количество();
	КонецЕсли;
	Для Индекс = 0 По Всего - 1 Цикл
		ЧислоА = ЧислоКомпонентыВерсии(ЧастиА, Индекс);
		ЧислоБ = ЧислоКомпонентыВерсии(ЧастиБ, Индекс);
		Если ЧислоА < ЧислоБ Тогда
			Возврат -1;
		ИначеЕсли ЧислоА > ЧислоБ Тогда
			Возврат 1;
		КонецЕсли;
	КонецЦикла;
	Возврат 0;
КонецФункции

&НаКлиенте
Функция ЧислоКомпонентыВерсии(Части, Индекс)
	Если Индекс >= Части.Количество() Тогда
		Возврат 0;
	КонецЕсли;
	Попытка
		Возврат Число(СокрЛП(Части[Индекс]));
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ПрименениеНастроекЗавершение(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт
#Если НЕ ВебКлиент Тогда
	СтатусСервера = НСтр("ru = 'Запуск прослушивания...'; en = 'Starting the listener...'");
	Попытка
		Компонента.НачатьВызовНачатьПрослушивание(
			Новый ОписаниеОповещения("ПрослушиваниеЗапущено", ЭтотОбъект), Порт);
	Исключение
		СтатусСервера = НСтр("ru = 'Ошибка запуска прослушивания'; en = 'Error starting the listener'");
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ПрослушиваниеЗапущено(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт
#Если НЕ ВебКлиент Тогда
	ТранспортЗапущен = Истина;
	МодульMCPVA.УстановитьВнешнийФасадМсп(ЭтотОбъект);
	СтатусСервера = СтрШаблон(НСтр("ru = 'Запущен: http://localhost:%1/mcp, инструментов: %2';
		|en = 'Running: http://localhost:%1/mcp, tools: %2'"),
		Формат(Порт, "ЧГ=0"), Формат(СчетчикИнструментов, "ЧН=0; ЧГ=0"));
	ОбновитьДоступностьЭлементов();

	// Заполняем выпадающий список моделей из ядра (на lite-компоненте вернётся ошибка — игнорируем)
	РагВызов("list_models", "{}", "ПолучениеСпискаМоделейЗавершение");

	Если РежимРаботы = "MCP+RAG" Тогда
		НачатьКонфигурациюRag();
	КонецЕсли;
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура СобратьИнструментыMCP()
#Если НЕ ВебКлиент Тогда
	КартаОбработчиков = Новый Соответствие;
	СписокИнструментовСбор = Новый Массив;

	ПараметрыСозданияMCP = Новый Структура;
	ПараметрыСозданияMCP.Вставить("МодульМсп_Сервер", ЭтотОбъект);
	ПараметрыСозданияMCP.Вставить("МодульМсп_СхемаПараметров", ЭтотОбъект);

	РежимСбораИнструментов = Истина;
	Попытка
		МодульMCPVA.ВызватьРегистрациюИнструментовMCP(ПараметрыСозданияMCP);
	Исключение
		РежимСбораИнструментов = Ложь;
		ВызватьИсключение;
	КонецПопытки;
	РежимСбораИнструментов = Ложь;

	// собственный инструмент плагина: скил по поиску (см. ОбработатьВызовИнструмента)
	Инструмент = Новый Структура;
	Инструмент.Вставить("name", "get_search_guide");
	Инструмент.Вставить("description",
		"Вернуть инструкцию (skill), как искать шаги, примеры и правила Vanessa Automation"
		+ " через семантический поиск: коллекции, режимы search, фильтры, workflow написания"
		+ " сценария. Вызови один раз перед подбором шагов или написанием сценария.");
	Инструмент.Вставить("inputSchema", НовыйСхемаОбъекта(Новый Структура, Новый Массив));
	СписокИнструментовСбор.Добавить(Инструмент);

	СчетчикИнструментов = СписокИнструментовСбор.Количество();
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ОстановитьТранспорт()
#Если НЕ ВебКлиент Тогда
	Если ТранспортЗапущен = Истина И МодульMCPVA <> Неопределено Тогда
		Попытка
			МодульMCPVA.УстановитьВнешнийФасадМсп(Неопределено);
		Исключение
		КонецПопытки;
	КонецЕсли;
	Если Компонента <> Неопределено Тогда
		Попытка
			Компонента.НачатьВызовОстановитьПрослушивание(ПустоеОповещение());
		Исключение
		КонецПопытки;
	КонецЕсли;
	Если Компонента <> Неопределено Тогда
		// Сброс ядра: освобождает коллекции и сессии модели (их память — гигабайты —
		// возвращается ОС); иначе синглтон rcore держит всё это в процессе 1С до его
		// завершения. При следующем запуске транспорта ядро настраивается заново.
		Попытка
			РагВызов("reset", "{}", "ОсвобождениеПамятиЗавершение");
		Исключение
		КонецПопытки;
	КонецЕсли;
	ТранспортЗапущен = Ложь;
	RagНастроен = Ложь;
	Попытка
		ОтключитьОбработчикОжидания("КонтрольАктуальностиИндекса");
	Исключение
	КонецПопытки;
	СтатусСервера = НСтр("ru = 'Остановлен'; en = 'Stopped'");
	СтатусИндексации = "";
	ОбновитьДоступностьЭлементов();
#КонецЕсли
КонецПроцедуры

// Fallback: форма открыта не как плагин — ищем открытое окно Vanessa Automation.
&НаКлиенте
Процедура НайтиКонтекстВанессы()
#Если НЕ ВебКлиент Тогда
	// "Окно" как имя переменной нельзя: это свойство формы (read-only, Window)
	Для Каждого ТекущееОкноКлиента Из ПолучитьОкна() Цикл
		Для Каждого ФормаОкна Из ТекущееОкноКлиента.Содержимое Цикл
			Попытка
				Если СтрНайти(ФормаОкна.ИмяФормы, "VanessaAutomation") = 0 Тогда
					Продолжить;
				КонецЕсли;
				// Проверяем, что это главная форма VA, через известный экспортный метод
				Проверка = ФормаОкна.ПолучитьКонтекстСохраняемый();
				Ванесса = ФормаОкна;
				Возврат;
			Исключение
				// не форма VA (нет ИмяФормы или метода) — пропускаем
			КонецПопытки;
		КонецЦикла;
	КонецЦикла;
#КонецЕсли
КонецПроцедуры

#КонецОбласти

#Область ФасадМспСервера

// Экспортные функции — фасад модулей Мсп_Сервер/Мсп_СхемаПараметров для MCPVA.
// В режиме сбора инструментов накапливают определения, в режиме диспетчеризации
// замыкают ответы на транспорт http1c, иначе делегируют в реальное расширение МСП.

&НаКлиенте
Функция НовыйСвойствоСхемы(Тип, Описание) Экспорт
	Возврат Новый Структура("type, description", Тип, Описание);
КонецФункции

&НаКлиенте
Функция НовыйСхемаОбъекта(Свойства, ТребуемыеПоля) Экспорт
	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", ТребуемыеПоля);
	Возврат Схема;
КонецФункции

&НаКлиенте
Функция НовыйИнструмент(Имя, Описание, Схема, Оповещение, Знач Асинхронный = Ложь) Экспорт
	Если РежимСбораИнструментов = Истина Тогда
		Инструмент = Новый Структура;
		Инструмент.Вставить("name", Имя);
		Инструмент.Вставить("description", Описание);
		Инструмент.Вставить("inputSchema", Схема);
		Инструмент.Вставить("_обработчик", Оповещение.ИмяПроцедуры);
		Возврат Инструмент;
	КонецЕсли;

	МодульМсп = Вычислить("Мсп_Сервер");
	Возврат МодульМсп.НовыйИнструмент(Имя, Описание, Схема, Оповещение, Асинхронный);
КонецФункции

&НаКлиенте
Процедура ЗарегистрироватьИнструмент(Инструмент, ИмяПровайдера) Экспорт
	Если РежимСбораИнструментов = Истина Тогда
		КартаОбработчиков.Вставить(Инструмент.name, Инструмент._обработчик);
		// в tools_json уходит чистое определение, без служебного поля
		Определение = Новый Структура;
		Определение.Вставить("name", Инструмент.name);
		Определение.Вставить("description", Инструмент.description);
		Определение.Вставить("inputSchema", Инструмент.inputSchema);
		СписокИнструментовСбор.Добавить(Определение);
		Возврат;
	КонецЕсли;

	МодульМсп = Вычислить("Мсп_Сервер");
	МодульМсп.ЗарегистрироватьИнструмент(Инструмент, ИмяПровайдера);
КонецПроцедуры

&НаКлиенте
Функция ОшибкаИнструмента(Код, Текст) Экспорт
	Если РежимДиспетчеризации = Истина Тогда
		Возврат Новый Структура("Http1cОшибкаИнструмента, Код, Сообщение", Истина, Код, Текст);
	КонецЕсли;

	МодульМсп = Вычислить("Мсп_Сервер");
	Возврат МодульМсп.ОшибкаИнструмента(Код, Текст);
КонецФункции

&НаКлиенте
Процедура ЗавершитьВызовИнструментаУспешно(Идентификатор, Текст) Экспорт
	ИнициализироватьСостояние();
	Если ОжидающиеЗапросы[Идентификатор] <> Неопределено Тогда
		ОтправитьРезультатИнструмента(Идентификатор, Текст, Ложь);
		Возврат;
	КонецЕсли;

	// чужой/устаревший идентификатор: без client_mcp делегировать некуда
	Попытка
		МодульМсп = Вычислить("Мсп_Сервер");
		МодульМсп.ЗавершитьВызовИнструментаУспешно(Идентификатор, Текст);
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВызовИнструментаСОшибкой(Идентификатор, Код, Текст) Экспорт
	ИнициализироватьСостояние();
	Если ОжидающиеЗапросы[Идентификатор] <> Неопределено Тогда
		ОтправитьРезультатИнструмента(Идентификатор, Код + ": " + Текст, Истина);
		Возврат;
	КонецЕсли;

	// чужой/устаревший идентификатор: без client_mcp делегировать некуда
	Попытка
		МодульМсп = Вычислить("Мсп_Сервер");
		МодульМсп.ЗавершитьВызовИнструментаСОшибкой(Идентификатор, Код, Текст);
	Исключение
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура УведомитьОПрогрессе(Идентификатор, Номер, Всего, Сообщение) Экспорт
#Если НЕ ВебКлиент Тогда
	ИнициализироватьСостояние();
	Если ОжидающиеЗапросы[Идентификатор] <> Неопределено Тогда
		Если Компонента <> Неопределено Тогда
			Компонента.НачатьВызовОтправитьПрогресс(ПустоеОповещение(), Идентификатор, Номер, Всего, Сообщение);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Попытка
		МодульМсп = Вычислить("Мсп_Сервер");
		МодульМсп.УведомитьОПрогрессе(Идентификатор, Номер, Всего, Сообщение);
	Исключение
	КонецПопытки;
#КонецЕсли
КонецПроцедуры

#КонецОбласти

#Область ДиспетчеризацияИнструментов

&НаКлиенте
Процедура ОбработатьВызовИнструмента(Данные)
#Если НЕ ВебКлиент Тогда
	Сообщение = ПрочитатьJSONИзСтроки(Данные);
	Если ТипЗнч(Сообщение) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	Идентификатор = Сообщение["id"];
	ИмяИнструмента = Сообщение["tool"];
	ОжидающиеЗапросы.Вставить(Идентификатор, Истина);

	// собственный инструмент плагина: скил по поиску из макета (дубль промпта
	// search-guide — инструменты, в отличие от промптов, агент видит всегда)
	Если ИмяИнструмента = "get_search_guide" Тогда
		Попытка
			ОтправитьРезультатИнструмента(Идентификатор, ТекстМакета("СкилПоиска"), Ложь);
		Исключение
			ОтправитьРезультатИнструмента(Идентификатор, "ACTION_FAILED: " + ОписаниеОшибки(), Истина);
		КонецПопытки;
		Возврат;
	КонецЕсли;

	ИмяОбработчика = КартаОбработчиков[ИмяИнструмента];
	Если ИмяОбработчика = Неопределено Тогда
		ОтправитьРезультатИнструмента(Идентификатор, "Unknown tool: " + Строка(ИмяИнструмента), Истина);
		Возврат;
	КонецЕсли;

	// Аргументы для обработчиков MCPVA — Структура (Запрос.Аргументы.Свойство())
	Аргументы = Новый Структура;
	АргументыСообщения = Сообщение["arguments"];
	Если ТипЗнч(АргументыСообщения) = Тип("Соответствие") Тогда
		Для Каждого КлючИЗначение Из АргументыСообщения Цикл
			Попытка
				Аргументы.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			Исключение
				// ключ не является допустимым идентификатором — пропускаем
			КонецПопытки;
		КонецЦикла;
	КонецЕсли;

	Запрос = Новый Структура("Идентификатор, Аргументы", Идентификатор, Аргументы);

	РежимДиспетчеризации = Истина;
	Попытка
		Результат = Вычислить("МодульMCPVA." + ИмяОбработчика + "(Запрос, Неопределено)");
	Исключение
		РежимДиспетчеризации = Ложь;
		ОтправитьРезультатИнструмента(Идентификатор, "ACTION_FAILED: " + ОписаниеОшибки(), Истина);
		Возврат;
	КонецПопытки;
	РежимДиспетчеризации = Ложь;

	Если Результат = Неопределено Тогда
		// отложенный ответ: обработчик завершит вызов через ЗавершитьВызовИнструмента*
	ИначеЕсли ТипЗнч(Результат) = Тип("Структура") И Результат.Свойство("Http1cОшибкаИнструмента") Тогда
		ОтправитьРезультатИнструмента(Идентификатор, Результат.Код + ": " + Результат.Сообщение, Истина);
	Иначе
		ОтправитьРезультатИнструмента(Идентификатор, Строка(Результат), Ложь);
	КонецЕсли;
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьРезультатИнструмента(Идентификатор, Текст, ЭтоОшибка)
#Если НЕ ВебКлиент Тогда
	ОжидающиеЗапросы.Удалить(Идентификатор);

	Если Компонента = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ЭлементСодержимого = Новый Структура("type, text", "text", Текст);
	Содержимое = Новый Массив;
	Содержимое.Добавить(ЭлементСодержимого);

	Результат = Новый Структура;
	Результат.Вставить("content", Содержимое);
	Если ЭтоОшибка Тогда
		Результат.Вставить("isError", Истина);
	КонецЕсли;

	// body — строка с уже сериализованным результатом (двойная сериализация)
	Конверт = Новый Структура;
	Конверт.Вставить("id", Идентификатор);
	Конверт.Вставить("body", ЗаписатьJSONВСтроку(Результат));

	Компонента.НачатьВызовОтправитьОтвет(ПустоеОповещение(), ЗаписатьJSONВСтроку(Конверт));
#КонецЕсли
КонецПроцедуры

#КонецОбласти

#Область ПромптыMCP

// Определения промптов MCP для prompts_json компоненты (сериализованный массив
// [{name, description, arguments}]). Один промпт search-guide без аргументов:
// инструкция для ИИ-агента, текст отдаёт ОбработатьЗапросПромпта из макета СкилПоиска.
&НаКлиенте
Функция ПромптыJson()
	Промпты = Новый Массив;

	Промпт = Новый Структура;
	Промпт.Вставить("name", "search-guide");
	Промпт.Вставить("title", "Vanessa: как искать шаги (RAG)");
	Промпт.Вставить("description",
		"Инструкция для ИИ-агента: как искать шаги, примеры и правила Vanessa Automation"
		+ " через семантический поиск (list_collections, search, grep, get_segment)");
	Промпт.Вставить("arguments", Новый Массив);
	Промпты.Добавить(Промпт);

	Возврат ЗаписатьJSONВСтроку(Промпты);
КонецФункции

// PromptGet: запрос {id, name} -> ответ prompts/get
// {"messages":[{"role":"user","content":{"type":"text","text":"..."}}]},
// при ошибке/неизвестном имени — {"error":"<текст>"} (протокол http1c).
&НаКлиенте
Процедура ОбработатьЗапросПромпта(Данные)
#Если НЕ ВебКлиент Тогда
	Сообщение = ПрочитатьJSONИзСтроки(Данные);
	Если ТипЗнч(Сообщение) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;

	Идентификатор = Сообщение["id"];
	ИмяПромпта = Строка(Сообщение["name"]);
	ОжидающиеЗапросы.Вставить(Идентификатор, Истина);

	Если ИмяПромпта <> "search-guide" И ИмяПромпта <> "search_guide" Тогда
		ОтправитьРезультатПромпта(Идентификатор,
			Новый Структура("error", "Unknown prompt: " + ИмяПромпта));
		Возврат;
	КонецЕсли;

	Попытка
		ТекстПромпта = ТекстМакета("СкилПоиска");
	Исключение
		ОтправитьРезультатПромпта(Идентификатор,
			Новый Структура("error", "Prompt error: " + ОписаниеОшибки()));
		Возврат;
	КонецПопытки;

	Содержимое = Новый Структура("type, text", "text", ТекстПромпта);
	СообщениеПромпта = Новый Структура("role, content", "user", Содержимое);
	Сообщения = Новый Массив;
	Сообщения.Добавить(СообщениеПромпта);

	ОтправитьРезультатПромпта(Идентификатор, Новый Структура("messages", Сообщения));
#КонецЕсли
КонецПроцедуры

// Конверт {id, body} как у ОтправитьРезультатИнструмента, но body — это
// сериализованный результат prompts/get целиком (без обёртки content/isError).
&НаКлиенте
Процедура ОтправитьРезультатПромпта(Идентификатор, Результат)
#Если НЕ ВебКлиент Тогда
	ОжидающиеЗапросы.Удалить(Идентификатор);

	Если Компонента = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Конверт = Новый Структура;
	Конверт.Вставить("id", Идентификатор);
	Конверт.Вставить("body", ЗаписатьJSONВСтроку(Результат));

	Компонента.НачатьВызовОтправитьОтвет(ПустоеОповещение(), ЗаписатьJSONВСтроку(Конверт));
#КонецЕсли
КонецПроцедуры

&НаСервере
Функция ТекстМакета(ИмяМакета)
	Возврат РеквизитФормыВЗначение("Объект").ПолучитьМакет(ИмяМакета).ПолучитьТекст();
КонецФункции

#КонецОбласти

#Область RAG

&НаКлиенте
Процедура НачатьКонфигурациюRag()
#Если НЕ ВебКлиент Тогда
	СтатусИндексации = НСтр("ru = 'Сброс ядра поиска...'; en = 'Resetting the search core...'");
	// Ядро живёт в процессе 1С дольше формы (rcore.dll не выгружается при
	// остановке сервера), поэтому без reset коллекции прошлых запусков —
	// в том числе переименованные/удалённые из таблицы — копились бы вечно
	// (рост числа сегментов от запуска к запуску). reset также освобождает
	// сессии модели прошлой конфигурации.
	РагВызов("reset", "{}", "СбросЯдраЗавершение");
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура СбросЯдраЗавершение(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт
#Если НЕ ВебКлиент Тогда
	// результат не важен: ядро могло быть и пустым — конфигурируем заново
	СтатусИндексации = СтрШаблон(НСтр("ru = 'Подготовка семантического поиска: загрузка модели «%1» и индексация шагов. При первом запуске модель скачивается — это может занять несколько минут...';
		|en = 'Preparing semantic search: loading model ""%1"" and indexing steps. On first start the model is downloaded — this may take several minutes...'"), Модель);

	Настройки = Новый Структура;
	Если СтрНайти(Модель, "\") > 0 ИЛИ СтрНайти(Модель, "/") > 0 ИЛИ СтрНайти(Модель, ":") > 0 Тогда
		Настройки.Вставить("model_path", Модель);
	Иначе
		Настройки.Вставить("model", Модель);
	КонецЕсли;
	Если ЗначениеЗаполнено(КаталогМоделей) Тогда
		Настройки.Вставить("cache_dir", КаталогМоделей);
	КонецЕсли;
	Настройки.Вставить("device", Устройство);
	// Каждый поток индексации — отдельная сессия (копия) модели в RAM
	// (~0.5–1.5 ГБ для e5-small), поэтому по умолчанию 1. 0 = на усмотрение
	// компоненты (половина ядер, максимум 4). После завершения индексации
	// bulk-сессии освобождаются (trim_memory) и пересоздаются лениво.
	Настройки.Вставить("embed_workers", ПотокиИндексации);
	Настройки.Вставить("normalize", Истина);

	РагВызов("configure", ЗаписатьJSONВСтроку(Настройки), "КонфигурацияRagЗавершение");
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура КонфигурацияRagЗавершение(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт
#Если НЕ ВебКлиент Тогда
	Конверт = ПрочитатьJSONИзСтроки(РезультатВызова);
	Если ТипЗнч(Конверт) <> Тип("Соответствие") ИЛИ Конверт["ok"] <> Истина Тогда
		// MCP транспорт продолжает работать без семантического поиска
		СтатусИндексации = СтрШаблон(НСтр("ru = 'Ошибка конфигурации RAG: %1'; en = 'RAG configuration error: %1'"),
			ТекстОшибкиКонверта(Конверт, РезультатВызова));
		Возврат;
	КонецЕсли;

	RagНастроен = Истина;
	ПодключитьОбработчикОжидания("КонтрольАктуальностиИндекса", 30, Истина);
	СтатусИндексации = НСтр("ru = 'Очистка коллекции...'; en = 'Clearing the collection...'");
	РагВызов("delete_collection", СтрокаУдаленияКоллекции(), "УдалениеКоллекцииЗавершение");
#КонецЕсли
КонецПроцедуры

// Следит за актуальностью индекса шагов: при смене языка генератора Gherkin или
// изменении размера библиотеки шагов (подключили/перечитали библиотеки) запускает
// переиндексацию автоматически. Перевзводится сам, пока транспорт запущен.
&НаКлиенте
Процедура КонтрольАктуальностиИндекса() Экспорт
#Если НЕ ВебКлиент Тогда
	Если ТранспортЗапущен <> Истина ИЛИ RagНастроен <> Истина ИЛИ РежимРаботы <> "MCP+RAG" Тогда
		Возврат;
	КонецЕсли;

	ТекущийЯзык = ТекущийЯзыкГенератора();
	ТекущееКоличествоШагов = КоличествоИзвестныхШагов();

	НужнаПереиндексация = Ложь;
	Если ЗначениеЗаполнено(ЯзыкИндексации) И ТекущийЯзык <> ЯзыкИндексации Тогда
		Сообщить(СтрШаблон(НСтр("ru = 'Язык генератора Gherkin изменился (%1 -> %2) — запускаю переиндексацию.';
			|en = 'Gherkin generator language changed (%1 -> %2) — starting reindexing.'"),
			ЯзыкИндексации, ТекущийЯзык));
		НужнаПереиндексация = Истина;
	ИначеЕсли КоличествоШаговПриИндексации <> Неопределено И ТекущееКоличествоШагов <> Неопределено
		И ТекущееКоличествоШагов <> КоличествоШаговПриИндексации Тогда
		Сообщить(СтрШаблон(НСтр("ru = 'Библиотека шагов изменилась (%1 -> %2 шагов) — запускаю переиндексацию.';
			|en = 'Step library changed (%1 -> %2 steps) — starting reindexing.'"),
			Формат(КоличествоШаговПриИндексации, "ЧН=0; ЧГ=0"), Формат(ТекущееКоличествоШагов, "ЧН=0; ЧГ=0")));
		НужнаПереиндексация = Истина;
	КонецЕсли;

	Если НужнаПереиндексация Тогда
		СтатусИндексации = НСтр("ru = 'Данные изменились: переиндексация...'; en = 'Data changed: reindexing...'");
		// через reset + configure — как кнопка «Переиндексировать» (см. там)
		НачатьКонфигурациюRag();
	КонецЕсли;

	ПодключитьОбработчикОжидания("КонтрольАктуальностиИндекса", 30, Истина);
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Функция ТекущийЯзыкГенератора()
	Язык = "ru";
	Попытка
		ЯзыкНастройки = СокрЛП(Ванесса.Объект.ЯзыкГенератораGherkin);
		Если ЗначениеЗаполнено(ЯзыкНастройки) Тогда
			Язык = ЯзыкНастройки;
		КонецЕсли;
	Исключение
		// настройка недоступна (старая версия VA) — считаем ru
	КонецПопытки;
	Возврат Язык;
КонецФункции

&НаКлиенте
Функция КоличествоИзвестныхШагов()
	Попытка
		Возврат Ванесса.ТаблицаИзвестныхStepDefinition.Количество();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура УдалениеКоллекцииЗавершение(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт
#Если НЕ ВебКлиент Тогда
	// результат не важен: коллекции могло не быть
	НачатьИндексациюШагов();
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура НачатьИндексациюШагов()
#Если НЕ ВебКлиент Тогда
	СтатусИндексации = НСтр("ru = 'Выгрузка шагов из Vanessa Automation...'; en = 'Exporting steps from Vanessa Automation...'");

	Попытка
		ШагиJson = Ванесса.ВсеДоступныеШагиMCP();
	Исключение
		СтатусИндексации = СтрШаблон(НСтр("ru = 'Ошибка выгрузки шагов: %1'; en = 'Step export error: %1'"),
			ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Шаги = ПрочитатьJSONИзСтроки(ШагиJson);
	Если ТипЗнч(Шаги) <> Тип("Массив") ИЛИ Шаги.Количество() = 0 Тогда
		СтатусИндексации = НСтр("ru = 'Шаги не получены (пустой ответ Vanessa Automation)';
			|en = 'No steps received (empty Vanessa Automation response)'");
		Возврат;
	КонецЕсли;

	// запоминаем язык и размер библиотеки шагов — КонтрольАктуальностиИндекса
	// сравнит их с текущими и при расхождении запустит переиндексацию
	ЯзыкИндексации = ТекущийЯзыкГенератора();
	КоличествоШаговПриИндексации = КоличествоИзвестныхШагов();

	ОчередьИндексации = Новый Массив;
	НомерБатча = 0;
	Сегменты = Новый Массив;
	ВсегоСегментов = 0;

	Для Каждого Шаг Из Шаги Цикл
		ИмяШага = Строка(Шаг["ИмяШага"]);
		Если НЕ ЗначениеЗаполнено(ИмяШага) Тогда
			Продолжить;
		КонецЕсли;
		ОписаниеШага = Строка(Шаг["ОписаниеШага"]);
		ТипШага = Строка(Шаг["ПолныйТипШага"]);

		Сегмент = Новый Структура;
		Сегмент.Вставить("text", ИмяШага);
		// категория шага (ПолныйТипШага) участвует в эмбеддинге: запросы вида
		// «шаги для работы с таблицами» находят шаги и по имени категории
		// (text в выдаче не меняется — обогащается только вектор)
		Сегмент.Вставить("embed_text", ИмяШага + Символы.ПС + ТипШага
			+ Символы.ПС + СинонимыДействий(ИмяШага)
			+ Символы.ПС + Лев(ОписаниеШага, 500));
		Сегмент.Вставить("meta", Новый Структура("type, lang", ТипШага, ЯзыкИндексации));
		Сегменты.Добавить(Сегмент);
		ВсегоСегментов = ВсегоСегментов + 1;

		Если Сегменты.Количество() >= 400 Тогда
			НомерБатча = НомерБатча + 1;
			ОчередьИндексации.Добавить(НовыйПакетИндексации(НомерБатча, Сегменты));
			Сегменты = Новый Массив;
		КонецЕсли;
	КонецЦикла;

	Если Сегменты.Количество() > 0 Тогда
		НомерБатча = НомерБатча + 1;
		ОчередьИндексации.Добавить(НовыйПакетИндексации(НомерБатча, Сегменты));
	КонецЕсли;

	СтатусИндексации = СтрШаблон(НСтр("ru = 'Индексация: %1 шагов, %2 пакетов...'; en = 'Indexing: %1 steps, %2 batches...'"),
		Формат(ВсегоСегментов, "ЧГ=0"), Формат(НомерБатча, "ЧГ=0"));
	ОтправитьСледующийПакетИндексации();
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Функция НовыйПакетИндексации(НомерБатча, Сегменты)
	Пакет = Новый Структура;
	Пакет.Вставить("collection", "vanessa_steps");
	Пакет.Вставить("collection_description", "Шаги Vanessa Automation (Gherkin/BDD)");
	Пакет.Вставить("doc_id", "vanessa_steps_" + Формат(НомерБатча, "ЧГ=0"));
	Пакет.Вставить("segments", Сегменты);
	Возврат Пакет;
КонецФункции

// Синонимы действий для embed_text: «кликаю/click» семантически ложатся на
// «нажимаю на кнопку» и т.п. — закрывает запросы, где модель не дотягивает
// лексику (текст шага в выдаче не меняется, обогащается только эмбеддинг).
&НаКлиенте
Функция СинонимыДействий(ИмяШага)
	ИмяНРег = НРег(ИмяШага);
	Термины = Новый Массив;
	ДобавитьСинонимы(Термины, ИмяНРег, "нажимаю", "кликаю щёлкаю щелкаю клик мышью press click");
	ДобавитьСинонимы(Термины, ИмяНРег, "ввожу", "заполняю печатаю набираю type fill input");
	ДобавитьСинонимы(Термины, ИмяНРег, "заполняю", "ввожу устанавливаю значение set fill");
	ДобавитьСинонимы(Термины, ИмяНРег, "выбираю", "выбор choose select");
	ДобавитьСинонимы(Термины, ИмяНРег, "открываю", "запускаю open");
	ДобавитьСинонимы(Термины, ИмяНРег, "закрываю", "завершаю close");
	ДобавитьСинонимы(Термины, ИмяНРег, "жду", "ожидаю ожидание пауза wait");
	ДобавитьСинонимы(Термины, ИмяНРег, "проверяю", "проверка убеждаюсь assert check verify");
	ДобавитьСинонимы(Термины, ИмяНРег, "кнопк", "button");
	ДобавитьСинонимы(Термины, ИмяНРег, "поле", "field input");
	ДобавитьСинонимы(Термины, ИмяНРег, "таблиц", "список grid table list");
	ДобавитьСинонимы(Термины, ИмяНРег, "флаж", "галочка чекбокс checkbox");
	ДобавитьСинонимы(Термины, ИмяНРег, "флаг", "галочка чекбокс checkbox");
	ДобавитьСинонимы(Термины, ИмяНРег, "гиперссылк", "ссылка link");
	ДобавитьСинонимы(Термины, ИмяНРег, "переключатель", "радиокнопка radio");
	ДобавитьСинонимы(Термины, ИмяНРег, "окн", "window");
	Возврат СтрСоединить(Термины, " ");
КонецФункции

&НаКлиенте
Процедура ДобавитьСинонимы(Термины, ИмяНРег, Подстрока, Синонимы)
	Если СтрНайти(ИмяНРег, Подстрока) > 0 Тогда
		Термины.Добавить(Синонимы);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСледующийПакетИндексации()
#Если НЕ ВебКлиент Тогда
	Если ОчередьИндексации.Количество() = 0 Тогда
		// шаги отправлены — дальше база знаний, затем коллекции файлов
		НачатьИндексациюБазыЗнаний();
		Возврат;
	КонецЕсли;

	Пакет = ОчередьИндексации[0];
	ОчередьИндексации.Удалить(0);
	РагВызов("index_segments", ЗаписатьJSONВСтроку(Пакет), "ПакетИндексацииЗавершение");
#КонецЕсли
КонецПроцедуры

// База знаний Vanessa Automation (макет БазаЗнанийДляMCP, формат "Вопрос: ...\n<ответ>")
// индексируется коллекцией vanessa_kb: один документ, сегмент = вопрос + ответ,
// embed_text = вопрос + начало ответа, meta = {type: "qa", num: <номер>}.
&НаКлиенте
Процедура НачатьИндексациюБазыЗнаний()
#Если НЕ ВебКлиент Тогда
	СтатусИндексации = НСтр("ru = 'Индексация базы знаний...'; en = 'Indexing the knowledge base...'");
	РагВызов("delete_collection", "{""collection"":""vanessa_kb""}", "УдалениеБазыЗнанийЗавершение");
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура УдалениеБазыЗнанийЗавершение(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт
#Если НЕ ВебКлиент Тогда
	// результат не важен: коллекции могло не быть
	Попытка
		Запрос = Новый Структура("Идентификатор, Аргументы", "", Новый Структура("format", "all"));
		ТекстБазы = МодульMCPVA.ПолучитьДанныеИзБазыЗнаний(Запрос, Неопределено);
	Исключение
		Сообщить(СтрШаблон(НСтр("ru = 'База знаний недоступна, коллекция vanessa_kb пропущена: %1';
			|en = 'Knowledge base is unavailable, the vanessa_kb collection is skipped: %1'"), ОписаниеОшибки()));
		НачатьИндексациюКоллекцийФайлов();
		Возврат;
	КонецПопытки;

	Если ТипЗнч(ТекстБазы) <> Тип("Строка") ИЛИ НЕ ЗначениеЗаполнено(ТекстБазы) Тогда
		Сообщить(НСтр("ru = 'База знаний пуста, коллекция vanessa_kb пропущена.';
			|en = 'Knowledge base is empty, the vanessa_kb collection is skipped.'"));
		НачатьИндексациюКоллекцийФайлов();
		Возврат;
	КонецЕсли;

	Сегменты = СегментыБазыЗнаний(ТекстБазы);
	Если Сегменты.Количество() = 0 Тогда
		Сообщить(НСтр("ru = 'В базе знаний не найдено вопросов (маркер ""Вопрос:""), коллекция vanessa_kb пропущена.';
			|en = 'No questions found in the knowledge base (the ""Вопрос:"" marker), the vanessa_kb collection is skipped.'"));
		НачатьИндексациюКоллекцийФайлов();
		Возврат;
	КонецЕсли;

	Пакет = Новый Структура;
	Пакет.Вставить("collection", "vanessa_kb");
	Пакет.Вставить("collection_description",
		"База знаний Vanessa Automation: частые вопросы и ответы — как правильно писать шаги и сценарии, типовые проблемы и их решения");
	Пакет.Вставить("doc_id", "vanessa_kb");
	Пакет.Вставить("segments", Сегменты);

	СтатусИндексации = СтрШаблон(НСтр("ru = 'Индексация базы знаний: %1 вопросов...'; en = 'Indexing the knowledge base: %1 questions...'"),
		Формат(Сегменты.Количество(), "ЧН=0; ЧГ=0"));
	РагВызов("index_segments", ЗаписатьJSONВСтроку(Пакет), "ИндексацияБазыЗнанийЗавершение");
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ИндексацияБазыЗнанийЗавершение(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт
#Если НЕ ВебКлиент Тогда
	Конверт = ПрочитатьJSONИзСтроки(РезультатВызова);
	Если ТипЗнч(Конверт) <> Тип("Соответствие") ИЛИ Конверт["ok"] <> Истина Тогда
		Сообщить(СтрШаблон(НСтр("ru = 'Ошибка индексации базы знаний: %1'; en = 'Knowledge base indexing error: %1'"),
			ТекстОшибкиКонверта(Конверт, РезультатВызова)));
	КонецЕсли;
	НачатьИндексациюКоллекцийФайлов();
#КонецЕсли
КонецПроцедуры

// Разбор текста базы знаний на сегменты "вопрос + ответ" по маркеру "Вопрос:"
// в начале строки (без учёта регистра — как в MCPVA.ПолучитьМассивВопросов).
&НаКлиенте
Функция СегментыБазыЗнаний(ТекстБазы)
	Сегменты = Новый Массив;
	ТекущийВопрос = "";
	СтрокиОтвета = Новый Массив;

	Строки = СтрРазделить(ТекстБазы, Символы.ПС, Истина);
	Для Каждого Строка Из Строки Цикл
		Если СтрНайти(НРег(Строка), "вопрос:") = 1 Тогда
			ДобавитьСегментБазыЗнаний(Сегменты, ТекущийВопрос, СтрокиОтвета);
			ТекущийВопрос = СокрЛП(Сред(Строка, СтрДлина("Вопрос:") + 1));
			СтрокиОтвета = Новый Массив;
		ИначеЕсли ЗначениеЗаполнено(ТекущийВопрос) Тогда
			СтрокиОтвета.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	ДобавитьСегментБазыЗнаний(Сегменты, ТекущийВопрос, СтрокиОтвета);

	Возврат Сегменты;
КонецФункции

&НаКлиенте
Процедура ДобавитьСегментБазыЗнаний(Сегменты, Вопрос, СтрокиОтвета)
	Если НЕ ЗначениеЗаполнено(Вопрос) Тогда
		Возврат;
	КонецЕсли;

	Ответ = СокрЛП(СтрСоединить(СтрокиОтвета, Символы.ПС));

	Сегмент = Новый Структура;
	Сегмент.Вставить("text", "Вопрос: " + Вопрос + Символы.ПС + Ответ);
	Сегмент.Вставить("embed_text", Вопрос + Символы.ПС + Лев(Ответ, 600));
	Сегмент.Вставить("meta", Новый Структура("type, num", "qa", Сегменты.Количество() + 1));
	Сегменты.Добавить(Сегмент);
КонецПроцедуры

&НаКлиенте
Процедура ПакетИндексацииЗавершение(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт
#Если НЕ ВебКлиент Тогда
	Конверт = ПрочитатьJSONИзСтроки(РезультатВызова);
	Если ТипЗнч(Конверт) <> Тип("Соответствие") ИЛИ Конверт["ok"] <> Истина Тогда
		ОчередьИндексации = Новый Массив;
		СтатусИндексации = СтрШаблон(НСтр("ru = 'Ошибка индексации: %1'; en = 'Indexing error: %1'"),
			ТекстОшибкиКонверта(Конверт, РезультатВызова));
		Возврат;
	КонецЕсли;
	ОтправитьСледующийПакетИндексации();
#КонецЕсли
КонецПроцедуры

// Коллекции файлов из таблицы формы: на каждую валидную строку (Коллекция и
// Каталог заполнены) — delete_collection → скан каталога по маскам расширений →
// index_raw по одному файлу на вызов (последовательная цепочка колбэков).
&НаКлиенте
Процедура НачатьИндексациюКоллекцийФайлов()
#Если НЕ ВебКлиент Тогда
	ОчередьКоллекцийФайлов = Новый Массив;

	НомерСтроки = 0;
	Для Каждого СтрокаКоллекции Из ТаблицаКоллекций Цикл
		НомерСтроки = НомерСтроки + 1;
		ИмяКоллекции = СокрЛП(СтрокаКоллекции.Коллекция);
		КаталогФайлов = СокрЛП(СтрокаКоллекции.Каталог);
		Если НЕ ЗначениеЗаполнено(ИмяКоллекции) И НЕ ЗначениеЗаполнено(КаталогФайлов)
			И НЕ ЗначениеЗаполнено(СокрЛП(СтрокаКоллекции.Описание))
			И НЕ ЗначениеЗаполнено(СокрЛП(СтрокаКоллекции.Расширения)) Тогда
			Продолжить; // полностью пустая строка — молча пропускаем
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ИмяКоллекции) ИЛИ НЕ ЗначениеЗаполнено(КаталогФайлов) Тогда
			Сообщить(СтрШаблон(НСтр("ru = 'Коллекции файлов: строка %1 пропущена — заполните «Коллекция» и «Каталог».';
				|en = 'File collections: row %1 skipped — fill in ""Collection"" and ""Directory"".'"),
				Формат(НомерСтроки, "ЧГ=0")));
			Продолжить;
		КонецЕсли;

		ОписаниеКоллекции = Новый Структура;
		ОписаниеКоллекции.Вставить("Имя", ИмяКоллекции);
		ОписаниеКоллекции.Вставить("Описание", СокрЛП(СтрокаКоллекции.Описание));
		ОписаниеКоллекции.Вставить("Каталог", КаталогФайлов);
		ОписаниеКоллекции.Вставить("Расширения", СокрЛП(СтрокаКоллекции.Расширения));
		ОчередьКоллекцийФайлов.Добавить(ОписаниеКоллекции);
	КонецЦикла;

	ОбработатьСледующуюКоллекциюФайлов();
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСледующуюКоллекциюФайлов()
#Если НЕ ВебКлиент Тогда
	Если ОчередьКоллекцийФайлов.Количество() = 0 Тогда
		// все коллекции обработаны — переходим к опросу stats
		ТекущаяКоллекцияФайлов = Неопределено;
		СтатусИндексации = НСтр("ru = 'Индексация в фоне (эмбеддинг)...'; en = 'Indexing in the background (embedding)...'");
		ПодключитьОбработчикОжидания("ОпроситьСтатусИндексации", 5, Истина);
		Возврат;
	КонецЕсли;

	ТекущаяКоллекцияФайлов = ОчередьКоллекцийФайлов[0];
	ОчередьКоллекцийФайлов.Удалить(0);

	СтатусИндексации = СтрШаблон(НСтр("ru = 'Коллекция ""%1"": очистка...'; en = 'Collection ""%1"": clearing...'"),
		ТекущаяКоллекцияФайлов.Имя);
	РагВызов("delete_collection",
		ЗаписатьJSONВСтроку(Новый Структура("collection", ТекущаяКоллекцияФайлов.Имя)),
		"УдалениеКоллекцииФайловЗавершение");
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура УдалениеКоллекцииФайловЗавершение(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт
#Если НЕ ВебКлиент Тогда
	// результат не важен: коллекции могло не быть
	СобратьФайлыКоллекции();
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура СобратьФайлыКоллекции()
#Если НЕ ВебКлиент Тогда
	ФайлыКоллекции = Новый Массив;
	УникальныеПути = Новый Соответствие;
	Для Каждого Маска Из МаскиИзРасширений(ТекущаяКоллекцияФайлов.Расширения) Цикл
		Попытка
			НайденныеФайлы = НайтиФайлы(ТекущаяКоллекцияФайлов.Каталог, Маска, Истина);
		Исключение
			НайденныеФайлы = Новый Массив;
		КонецПопытки;
		Для Каждого НайденныйФайл Из НайденныеФайлы Цикл
			Если НЕ НайденныйФайл.ЭтоФайл() Тогда
				Продолжить;
			КонецЕсли;
			КлючПути = НРег(НайденныйФайл.ПолноеИмя);
			Если УникальныеПути[КлючПути] = Неопределено Тогда
				УникальныеПути.Вставить(КлючПути, Истина);
				ФайлыКоллекции.Добавить(НайденныйФайл.ПолноеИмя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если ФайлыКоллекции.Количество() = 0 Тогда
		Сообщить(СтрШаблон(НСтр("ru = 'Коллекция %1: файлы не найдены в %2'; en = 'Collection %1: no files found in %2'"),
			ТекущаяКоллекцияФайлов.Имя, ТекущаяКоллекцияФайлов.Каталог));
		ОбработатьСледующуюКоллекциюФайлов();
		Возврат;
	КонецЕсли;

	ТекущаяКоллекцияФайлов.Вставить("Файлы", ФайлыКоллекции);
	ТекущаяКоллекцияФайлов.Вставить("Индекс", 0);
	ОтправитьСледующийФайлКоллекции();
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСледующийФайлКоллекции()
#Если НЕ ВебКлиент Тогда
	ФайлыКоллекции = ТекущаяКоллекцияФайлов.Файлы;
	Если ТекущаяКоллекцияФайлов.Индекс >= ФайлыКоллекции.Количество() Тогда
		ОбработатьСледующуюКоллекциюФайлов();
		Возврат;
	КонецЕсли;

	ПутьКФайлу = ФайлыКоллекции[ТекущаяКоллекцияФайлов.Индекс];
	ТекущаяКоллекцияФайлов.Индекс = ТекущаяКоллекцияФайлов.Индекс + 1;
	ТекущаяКоллекцияФайлов.Вставить("ТекущийФайл", ПутьКФайлу);

	СтатусИндексации = СтрШаблон(НСтр("ru = 'Коллекция ""%1"": файл %2 из %3...'; en = 'Collection ""%1"": file %2 of %3...'"),
		ТекущаяКоллекцияФайлов.Имя, Формат(ТекущаяКоллекцияФайлов.Индекс, "ЧН=0; ЧГ=0"),
		Формат(ФайлыКоллекции.Количество(), "ЧН=0; ЧГ=0"));

	ОписаниеФайла = Новый Файл(ПутьКФайлу);
	Попытка
		РазмерФайла = ОписаниеФайла.Размер();
	Исключение
		Сообщить(СтрШаблон(НСтр("ru = 'Коллекция %1: не удалось прочитать %2: %3'; en = 'Collection %1: failed to read %2: %3'"),
			ТекущаяКоллекцияФайлов.Имя, ПутьКФайлу, ОписаниеОшибки()));
		ОтправитьСледующийФайлКоллекции();
		Возврат;
	КонецПопытки;
	Если РазмерФайла > 5 * 1024 * 1024 Тогда
		Сообщить(СтрШаблон(НСтр("ru = 'Коллекция %1: пропущен %2 (больше 5 МБ)'; en = 'Collection %1: skipped %2 (larger than 5 MB)'"),
			ТекущаяКоллекцияФайлов.Имя, ПутьКФайлу));
		ОтправитьСледующийФайлКоллекции();
		Возврат;
	КонецЕсли;

	Попытка
		ЧтениеФайла = Новый ЧтениеТекста(ПутьКФайлу, КодировкаТекста.UTF8);
		ТекстФайла = ЧтениеФайла.Прочитать();
		ЧтениеФайла.Закрыть();
	Исключение
		Сообщить(СтрШаблон(НСтр("ru = 'Коллекция %1: не удалось прочитать %2: %3'; en = 'Collection %1: failed to read %2: %3'"),
			ТекущаяКоллекцияФайлов.Имя, ПутьКФайлу, ОписаниеОшибки()));
		ОтправитьСледующийФайлКоллекции();
		Возврат;
	КонецПопытки;
	Если ТекстФайла = Неопределено Тогда
		ТекстФайла = ""; // пустой файл
	КонецЕсли;

	РасширениеФайла = ОписаниеФайла.Расширение;
	Если Лев(РасширениеФайла, 1) = "." Тогда
		РасширениеФайла = Сред(РасширениеФайла, 2);
	КонецЕсли;

	Пакет = Новый Структура;
	Пакет.Вставить("collection", ТекущаяКоллекцияФайлов.Имя);
	// collection_description передаём на каждом вызове: последний непустой побеждает
	Пакет.Вставить("collection_description", ТекущаяКоллекцияФайлов.Описание);
	Пакет.Вставить("doc_id", ПутьКФайлу);
	Пакет.Вставить("name", ОписаниеФайла.Имя);
	Пакет.Вставить("text", ТекстФайла);
	Пакет.Вставить("meta", Новый Структура("path, ext", ПутьКФайлу, РасширениеФайла));

	// .feature режем по границам сценариев (chunk_cfg ядра rcore):
	//  - boundary_regex: строка-заголовок сценария всегда начинает новый чанк,
	//    перекрытие через границу не переносится — хит это осмысленный кусок
	//    одного сценария, а не склейка хвоста одного с началом другого;
	//  - boundary_lead_regex: комментарии (#) и теги (@) над сценарием попадают
	//    в чанк ИМЕННО этого сценария, а не предыдущего;
	//  - prepend_header: шапка фича-файла (Функционал + описание + Контекст до
	//    первого сценария) подмешивается в эмбеддинг каждого сценария, чтобы не
	//    терять контекст (текст хита и диапазон строк при этом не меняются).
	// Функционал/Контекст/Предыстория НЕ являются границами — они и есть шапка;
	// «Примеры:»/Examples тоже не граница — таблица примеров остаётся при своей
	// «Структуре сценария».
	Если НРег(РасширениеФайла) = "feature" Тогда
		НастройкаЧанков = Новый Структура;
		НастройкаЧанков.Вставить("boundary_regex",
			"(?i)^[ \t]*(структура сценария|шаблон сценария|сценарий|scenario outline|scenario template|scenario)[ \t]*:");
		НастройкаЧанков.Вставить("boundary_lead_regex", "^[ \t]*[@#]");
		НастройкаЧанков.Вставить("prepend_header", Истина);
		Пакет.Вставить("chunk_cfg", НастройкаЧанков);
	КонецЕсли;

	РагВызов("index_raw", ЗаписатьJSONВСтроку(Пакет), "ФайлКоллекцииЗавершение");
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ФайлКоллекцииЗавершение(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт
#Если НЕ ВебКлиент Тогда
	Конверт = ПрочитатьJSONИзСтроки(РезультатВызова);
	Если ТипЗнч(Конверт) <> Тип("Соответствие") ИЛИ Конверт["ok"] <> Истина Тогда
		// ошибка одного файла не прерывает обработку остальных
		Сообщить(СтрШаблон(НСтр("ru = 'Коллекция %1: ошибка индексации %2: %3'; en = 'Collection %1: indexing error for %2: %3'"),
			ТекущаяКоллекцияФайлов.Имя, ТекущаяКоллекцияФайлов.ТекущийФайл,
			ТекстОшибкиКонверта(Конверт, РезультатВызова)));
	КонецЕсли;
	ОтправитьСледующийФайлКоллекции();
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ОпроситьСтатусИндексации() Экспорт
#Если НЕ ВебКлиент Тогда
	Если Компонента = Неопределено ИЛИ ТранспортЗапущен <> Истина Тогда
		Возврат;
	КонецЕсли;
	РагВызов("stats", "{}", "ОпросСтатусаИндексацииЗавершение");
#КонецЕсли
КонецПроцедуры

// Агрегирует прогресс по ВСЕМ коллекциям из result.collections: суммы embedded
// и n_segments; готово — когда у всех vector_status = "ready"; ошибка — если
// хотя бы у одной "error" (коллекция называется в статусе).
&НаКлиенте
Процедура ОпросСтатусаИндексацииЗавершение(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт
#Если НЕ ВебКлиент Тогда
	Эмбеддинг = 0;
	ВсегоСегментов = 0;
	КоличествоКоллекций = 0;
	ВсеГотовы = Истина;
	КоллекцияСОшибкой = "";
	Попытка
		Конверт = ПрочитатьJSONИзСтроки(РезультатВызова);
		Коллекции = Конверт["result"]["collections"];
		Если ТипЗнч(Коллекции) = Тип("Соответствие") Тогда
			Для Каждого КлючИЗначение Из Коллекции Цикл
				ДанныеКоллекции = КлючИЗначение.Значение;
				КоличествоКоллекций = КоличествоКоллекций + 1;
				Эмбеддинг = Эмбеддинг + ДанныеКоллекции["embedded"];
				ВсегоСегментов = ВсегоСегментов + ДанныеКоллекции["n_segments"];
				ВекторныйСтатус = Строка(ДанныеКоллекции["vector_status"]);
				Если ВекторныйСтатус = "error" И НЕ ЗначениеЗаполнено(КоллекцияСОшибкой) Тогда
					КоллекцияСОшибкой = Строка(КлючИЗначение.Ключ);
				КонецЕсли;
				Если ВекторныйСтатус <> "ready" Тогда
					ВсеГотовы = Ложь;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
		ВсеГотовы = Ложь;
	КонецПопытки;

	Если ЗначениеЗаполнено(КоллекцияСОшибкой) Тогда
		СтатусИндексации = СтрШаблон(НСтр("ru = 'Ошибка эмбеддинга в коллекции ""%1"" (vector_status=error)';
			|en = 'Embedding error in collection ""%1"" (vector_status=error)'"), КоллекцияСОшибкой);
	ИначеЕсли ВсеГотовы И КоличествоКоллекций > 0 Тогда
		СтатусИндексации = СтрШаблон(НСтр("ru = 'Готово: %1 сегментов в %2 коллекциях'; en = 'Ready: %1 segments in %2 collections'"),
			Формат(ВсегоСегментов, "ЧН=0; ЧГ=0"), Формат(КоличествоКоллекций, "ЧН=0; ЧГ=0"));
		// Индексация завершена — вернуть память bulk-сессий модели (каждая
		// ~0.5–1.5 ГБ); при следующей индексации ядро пересоздаст их лениво.
		РагВызов("trim_memory", "{}", "ОсвобождениеПамятиЗавершение");
	ИначеЕсли ТранспортЗапущен = Истина Тогда
		СтатусИндексации = СтрШаблон(НСтр("ru = 'Эмбеддинг: %1 из %2 чанков (коллекций: %3)...'; en = 'Embedding: %1 of %2 chunks (collections: %3)...'"),
			Формат(Эмбеддинг, "ЧН=0; ЧГ=0"), Формат(ВсегоСегментов, "ЧН=0; ЧГ=0"),
			Формат(КоличествоКоллекций, "ЧН=0; ЧГ=0"));
		ПодключитьОбработчикОжидания("ОпроситьСтатусИндексации", 5, Истина);
	КонецЕсли;
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ОсвобождениеПамятиЗавершение(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт
	// результат не важен: освобождение памяти (trim_memory, reset при остановке) —
	// best effort (старое ядро без метода ответит ошибкой, работа продолжается)
КонецПроцедуры

&НаКлиенте
Процедура ПолучениеСпискаМоделейЗавершение(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт
#Если НЕ ВебКлиент Тогда
	Конверт = ПрочитатьJSONИзСтроки(РезультатВызова);
	Если ТипЗнч(Конверт) <> Тип("Соответствие") ИЛИ Конверт["ok"] <> Истина Тогда
		Возврат; // lite-компонента или метод недоступен — остаётся список по умолчанию
	КонецЕсли;

	Модели = Новый Массив;
	Попытка
		СписокИзЯдра = Конверт["result"]["models"];
		Если ТипЗнч(СписокИзЯдра) = Тип("Массив") Тогда
			Для Каждого ЭлементСписка Из СписокИзЯдра Цикл
				Если ТипЗнч(ЭлементСписка) = Тип("Строка") Тогда
					Модели.Добавить(ЭлементСписка);
				ИначеЕсли ТипЗнч(ЭлементСписка) = Тип("Соответствие") Тогда
					Модели.Добавить(Строка(ЭлементСписка["name"]));
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Если Модели.Количество() > 0 Тогда
		ЗаполнитьСписокВыбораМоделей(Модели);
	КонецЕсли;
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура РагВызов(Метод, ДанныеJson, ИмяОбработчика)
#Если НЕ ВебКлиент Тогда
	Если Компонента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Компонента.НачатьВызовRagВыполнить(
			Новый ОписаниеОповещения(ИмяОбработчика, ЭтотОбъект), Метод, ДанныеJson);
	Исключение
		СтатусИндексации = СтрШаблон(НСтр("ru = 'Ошибка вызова RagВыполнить(%1): %2'; en = 'Error calling RagВыполнить(%1): %2'"),
			Метод, ОписаниеОшибки());
	КонецПопытки;
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Функция СтрокаУдаленияКоллекции()
	Возврат "{""collection"":""vanessa_steps""}";
КонецФункции

// Маски НайтиФайлы из фильтра расширений: "feature" → "*.feature";
// "feature;md;txt" → три маски; ".md" и "*.md" тоже допустимы. Пусто — "*.feature".
&НаКлиенте
Функция МаскиИзРасширений(СтрокаРасширений)
	Маски = Новый Массив;
	Для Каждого ЧастьСтроки Из СтрРазделить(СтрокаРасширений, ";,", Ложь) Цикл
		РасширениеФайла = СокрЛП(ЧастьСтроки);
		Если НЕ ЗначениеЗаполнено(РасширениеФайла) Тогда
			Продолжить;
		КонецЕсли;
		Если Лев(РасширениеФайла, 1) = "*" Тогда
			Маски.Добавить(РасширениеФайла);
		ИначеЕсли Лев(РасширениеФайла, 1) = "." Тогда
			Маски.Добавить("*" + РасширениеФайла);
		Иначе
			Маски.Добавить("*." + РасширениеФайла);
		КонецЕсли;
	КонецЦикла;
	Если Маски.Количество() = 0 Тогда
		Маски.Добавить("*.feature");
	КонецЕсли;
	Возврат Маски;
КонецФункции

&НаКлиенте
Функция ТекстОшибкиКонверта(Конверт, РезультатВызова)
	Текст = "";
	Попытка
		Текст = Строка(Конверт["error"]["code"]) + ": " + Строка(Конверт["error"]["message"]);
	Исключение
	КонецПопытки;
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Текст = Лев(Строка(РезультатВызова), 300);
	КонецЕсли;
	Возврат Текст;
КонецФункции

#КонецОбласти

#Область СтатусИОформление

&НаКлиенте
Процедура ПолучениеСтатусаЗавершение(РезультатВызова, ПараметрыВызова, ДополнительныеПараметры) Экспорт
#Если НЕ ВебКлиент Тогда
	Статус = ПрочитатьJSONИзСтроки(РезультатВызова);
	Если ТипЗнч(Статус) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(Статус["version"]) Тогда
		ВерсияКомпоненты = СокрЛП(Строка(Статус["version"]));
	КонецЕсли;
	Если Статус["running"] = Истина Тогда
		СтатусСервера = СтрШаблон(НСтр("ru = 'Запущен: http://localhost:%1/mcp, инструментов: %2, запросов в работе: %3';
			|en = 'Running: http://localhost:%1/mcp, tools: %2, pending requests: %3'"),
			Формат(Статус["port"], "ЧГ=0"), Формат(Статус["tools_registered"], "ЧН=0; ЧГ=0"),
			Формат(Статус["pending_requests"], "ЧН=0; ЧГ=0"));
	Иначе
		СтатусСервера = НСтр("ru = 'Остановлен'; en = 'Stopped'");
	КонецЕсли;
#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДоступностьЭлементов()
	РежимRag = (РежимРаботы = "MCP+RAG");
	НастройкиДоступны = (ТранспортЗапущен <> Истина); // пока сервер работает, настройки не меняем
	Элементы.ГруппаНастройки.Доступность = НастройкиДоступны;
	Элементы.ГруппаRAG.Доступность = РежимRag И НастройкиДоступны;
	Элементы.Переиндексировать.Видимость = РежимRag;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСсылкуНаМодель()
	СсылкаНаМодельURL = "";
	ИмяМодели = СокрЛП(Модель);
	Описание = Неопределено;
	Если СтрНайти(ИмяМодели, "\") = 0 И СтрНайти(ИмяМодели, "/") = 0 И СтрНайти(ИмяМодели, ":") = 0 Тогда
		Описание = ОписанияМоделей()[ИмяМодели];
	КонецЕсли;
	Если Описание = Неопределено Тогда
		// путь к офлайн-модели или неизвестное имя — страницы для скачивания нет
		Элементы.СсылкаНаМодель.Видимость = Ложь;
		Возврат;
	КонецЕсли;
	СсылкаНаМодельURL = Описание.URL;
	Элементы.СсылкаНаМодель.Заголовок = СтрШаблон(НСтр("ru = 'Страница модели: %1 (%2)'; en = 'Model page: %1 (%2)'"),
		Описание.Репозиторий, Описание.Размер);
	Элементы.СсылкаНаМодель.Видимость = Истина;
КонецПроцедуры

// Репозитории Hugging Face, из которых fastembed 5.16.0 скачивает модели.
&НаКлиенте
Функция ОписанияМоделей()
	Модели = Новый Соответствие;
	Модели.Вставить("multilingual-e5-small", НовоеОписаниеМодели("intfloat/multilingual-e5-small", НСтр("ru = '~0.5 ГБ'; en = '~0.5 GB'")));
	Модели.Вставить("multilingual-e5-base", НовоеОписаниеМодели("intfloat/multilingual-e5-base", НСтр("ru = '~1.1 ГБ'; en = '~1.1 GB'")));
	Модели.Вставить("multilingual-e5-large", НовоеОписаниеМодели("Qdrant/multilingual-e5-large-onnx", НСтр("ru = '~2.2 ГБ'; en = '~2.2 GB'")));
	Возврат Модели;
КонецФункции

&НаКлиенте
Функция НовоеОписаниеМодели(Репозиторий, Размер)
	Возврат Новый Структура("URL, Репозиторий, Размер",
		"https://huggingface.co/" + Репозиторий, Репозиторий, Размер);
КонецФункции

&НаКлиенте
Процедура ЗаполнитьСписокВыбораМоделей(Модели)
	Элементы.Модель.СписокВыбора.Очистить();
	Для Каждого ИмяМодели Из Модели Цикл
		Элементы.Модель.СписокВыбора.Добавить(ИмяМодели);
	КонецЦикла;
	ОбновитьСсылкуНаМодель();
КонецПроцедуры

&НаКлиенте
Функция СписокМоделейПоУмолчанию()
	Модели = Новый Массив;
	Модели.Добавить("multilingual-e5-small");
	Модели.Добавить("multilingual-e5-base");
	Модели.Добавить("multilingual-e5-large");
	Возврат Модели;
КонецФункции

#КонецОбласти

#Область Помощники

&НаКлиенте
Процедура ИнициализироватьСостояние()
	Если ОжидающиеЗапросы = Неопределено Тогда
		ОжидающиеЗапросы = Новый Соответствие;
		КартаОбработчиков = Новый Соответствие;
		СписокИнструментовСбор = Новый Массив;
		ОчередьИндексации = Новый Массив;
		ОчередьКоллекцийФайлов = Новый Массив;
		ТекущаяКоллекцияФайлов = Неопределено;
		ТранспортЗапущен = Ложь;
		РежимДиспетчеризации = Ложь;
		РежимСбораИнструментов = Ложь;
		RagНастроен = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ЗаписатьJSONВСтроку(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

&НаКлиенте
Функция ПрочитатьJSONИзСтроки(ИсходнаяСтрока)
	Если НЕ ЗначениеЗаполнено(ИсходнаяСтрока) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ИсходнаяСтрока);
		Возврат ПрочитатьJSON(Чтение, Истина);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаКлиенте
Функция ПустоеОповещение()
	Возврат Новый ОписаниеОповещения("ПустойОбработчикКолбэка", ЭтотОбъект);
КонецФункции

